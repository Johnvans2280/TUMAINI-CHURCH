# Tumaini Church - Environment Variables Template
# Copy this file to .env and fill in your Supabase credentials:

# Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anonymous Public API Key (anon key only)
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Optional AI Studio platform keys:
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
